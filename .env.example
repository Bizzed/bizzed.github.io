# ---------------------------------------------------------------------------
# Site build (PUBLIC_* only)
#
# Anything prefixed PUBLIC_ is compiled into the HTML that GitHub Pages serves.
# Treat every value in this file as readable by anyone. Real secrets live in
# the Worker — see worker/.dev.vars and `wrangler secret put`.
# ---------------------------------------------------------------------------

# The Cloudflare Worker the form posts to.
# After `npm run worker:deploy`, wrangler prints this URL.
PUBLIC_FORM_ENDPOINT=https://bizzed-form-endpoint.<your-subdomain>.workers.dev

# Turnstile SITE key (the public half of the pair).
# The value below is Cloudflare's documented always-passes test key, which is
# fine for local development. Replace it with the real site key for deploys.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

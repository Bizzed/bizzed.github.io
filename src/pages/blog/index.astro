<BaseLayout
  title="Blog | Bizzed AI"
  description="Insights on AI-driven business acquisition, due diligence, and deal analysis."
>
  <section class="mx-auto max-w-container px-6 py-20">
    <h1 class="font-display text-4xl md:text-5xl font-semibold tracking-tight">Blog</h1>
    <p class="mt-4 text-ink-muted max-w-2xl">
      Coming soon — insights from the Bizzed team on AI, due diligence, and the
      future of business acquisition.
    </p>
  </section>
</BaseLayout>

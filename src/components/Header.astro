---
// Header mirrors the current bizzed.ai navigation:
// Bizzed logo on the left, Get Started CTA on the right.
---

<header class="sticky top-0 z-50 backdrop-blur bg-bg/70 border-b border-border-subtle">
  <div class="mx-auto max-w-container px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      Bizzed
    </a>
    <nav class="flex items-center gap-6">
      <!-- Future nav items go here: /blog, /resources, etc. -->
      <a
        href="/get-started"
        class="inline-flex items-center rounded-md bg-ink text-bg px-4 py-2 text-sm font-medium hover:bg-ink-soft transition-colors"
      >
        Get Started
      </a>
    </nav>
  </div>
</header>
